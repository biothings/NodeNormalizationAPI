{
  "openapi": "3.1.0",
  "info": {
    "title": "Node Normalization",
    "version": "1.1.0",
    "x-translator": {
      "component": "Utility",
      "team": [
        "DOGSURF"
      ],
      "infores": "infores:sri-node-normalizer"
    },
    "contact": {
      "email": "shuchenliu2014@gmail.com",
      "name": "Will Liu",
      "x-id": "https://github.com/shuchenliu",
      "x-role": "responsible developer"
    },
    "termsOfService": "https://toss.apps.renci.org/tos?service_long=Node+Normalization&provider_long=the+Translator+Consortium",
    "description": "Node Normalization takes a CURIE, and returns: <ol> <li>The preferred CURIE for this entity <li>All other known equivalent identifiers for the entity <li>Semantic types for the entity as defined by the <a href=\"https://biolink.github.io/biolink-model/\">Biolink Model</a> </ol> This is the Elasticsearch-backed implementation of the Node Normalization API, maintained by the <a href=\"https://biothings.io\">BioThings</a> group at Scripps Research (<a href=\"https://github.com/biothings/NodeNormalizationAPI\">source code</a>). The data it serves is created by <a href=\"https://github.com/NCATSTranslator/Babel\">Babel</a>, which finds identifier equivalences and makes sure that CURIE prefixes are Biolink Model compliant. To determine whether Node Normalization is likely to be useful, check /get_semantic_types, which lists the Biolink semantic types for which normalization has been attempted. The semantics of each endpoint are described in the <a href=\"https://github.com/NCATSTranslator/NodeNormalization/blob/main/documentation/API.md\">Node Normalization API documentation</a>. To learn more about how Babel creates cliques of equivalent identifiers, <a href=\"https://github.com/NCATSTranslator/Babel/blob/main/docs/README.md\">read its documentation</a>."
  },
  "servers": [
    {
      "description": "Continuous integration",
      "url": "https://nodenorm-es.ci.transltr.io/",
      "x-maturity": "staging",
      "x-location": "ITRB"
    },
    {
      "description": "Test",
      "url": "https://nodenorm-es.test.transltr.io/",
      "x-maturity": "testing",
      "x-location": "ITRB"
    },
    {
      "description": "Localhost",
      "url": "http://localhost:8000/",
      "x-maturity": "development"
    }
  ],
  "tags": [
    {
      "name": "translator"
    },
    {
      "name": "health"
    },
    {
      "name": "metadata"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Status information on this NodeNorm instance",
        "tags": ["health"],
        "description": "Returns information about this NodeNorm instance, the Babel release it serves and the Elasticsearch cluster backing it. `status` is `error` when the Elasticsearch cluster cannot be reached.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Status of this NodeNorm instance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["running", "error"]},
                    "version": {"type": "string", "description": "The `info.version` of this OpenAPI document"},
                    "babel_version": {"type": "string", "description": "The Babel release loaded into the index"},
                    "babel_version_url": {"type": "string", "format": "uri", "description": "Release notes for that Babel release"},
                    "backend": {"type": "string", "enum": ["elasticsearch"]},
                    "biolink_model_toolkit_version": {"type": "string"},
                    "elasticsearch": {"type": "object", "description": "Per-node statistics from the cluster's `_cat/nodes`"}
                  },
                  "required": ["status", "version", "babel_version", "babel_version_url", "backend"]
                },
                "example": {
                  "status": "running",
                  "version": "1.1.0",
                  "babel_version": "2025sep1",
                  "babel_version_url": "https://github.com/NCATSTranslator/Babel/blob/main/releases/2025sep1/README.md",
                  "backend": "elasticsearch",
                  "biolink_model_toolkit_version": "v4.4.3",
                  "elasticsearch": {
                    "nodes": {
                      "es-0": {
                        "name": "es-0",
                        "cpu": "0",
                        "disk.avail": "334.2gb",
                        "disk.total": "786.3gb",
                        "disk.used": "452.1gb",
                        "disk.used_percent": "57.50",
                        "heap.current": "5.8gb",
                        "heap.max": "16gb",
                        "load_1m": "0.16",
                        "load_5m": "0.16",
                        "load_15m": "0.19",
                        "uptime": "81.2d",
                        "version": "9.3.1"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "The git commit this instance was built from",
        "tags": ["health"],
        "description": "Returns the git commit hash of the deployed code. For the API version, see `version` in /status.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "The deployed commit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {"type": "string"}
                  },
                  "required": ["version"]
                },
                "example": {"version": "fa7d74dc9537373fb36a7bef0d29cdaf4e83b897"}
              }
            }
          }
        }
      }
    },
    "/get_normalized_nodes": {
      "get": {
        "summary": "Get the equivalent identifiers and semantic types for the curie(s) entered.",
        "tags": ["translator"],
        "description": "Returns the equivalent identifiers and semantic types for the curie(s). Each input CURIE maps to a normalized node, or to `null` if it is unknown.",
        "operationId": "get_normalized_nodes_get",
        "parameters": [
          {
            "name": "curie",
            "in": "query",
            "description": "List of curies to normalize",
            "required": true,
            "schema": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "example": ["MESH:D014867", "NCIT:C34373"]
          },
          {
            "name": "conflate",
            "in": "query",
            "description": "Whether to apply gene/protein conflation",
            "required": false,
            "schema": {"type": "boolean", "default": true}
          },
          {
            "name": "drug_chemical_conflate",
            "in": "query",
            "description": "Whether to apply drug/chemical conflation",
            "required": false,
            "schema": {"type": "boolean", "default": false}
          },
          {
            "name": "description",
            "in": "query",
            "description": "Whether to return curie descriptions when possible",
            "required": false,
            "schema": {"type": "boolean", "default": false}
          },
          {
            "name": "individual_types",
            "in": "query",
            "description": "Whether to return individual types for equivalent identifiers",
            "required": false,
            "schema": {"type": "boolean", "default": false}
          }
        ],
        "responses": {
          "200": {
            "description": "A normalized node (or `null`) for every input CURIE",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/NormalizedNodes"},
                "examples": {"default": {"$ref": "#/components/examples/NormalizedNodes"}}
              }
            }
          },
          "400": {
            "description": "No `curie` parameter was supplied"
          }
        }
      },
      "post": {
        "summary": "Get the equivalent identifiers and semantic types for the curie(s) entered.",
        "tags": ["translator"],
        "description": "Returns the equivalent identifiers and semantic types for the curie(s). Use the `conflate` and `drug_chemical_conflate` flags to choose which conflations to apply.",
        "operationId": "get_normalized_nodes_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CurieList"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "A normalized node (or `null`) for every input CURIE",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/NormalizedNodes"},
                "examples": {"default": {"$ref": "#/components/examples/NormalizedNodes"}}
              }
            }
          },
          "400": {
            "description": "The body has no `curies`"
          }
        }
      }
    },
    "/get_setid": {
      "get": {
        "summary": "Normalize and deduplicate a set of identifiers and return a single hash that represents this set.",
        "tags": ["translator"],
        "description": "Returns the set ID for a given set of CURIEs. A set ID is an identifier that can be used to identify this set of CURIEs going forward. It is currently impossible to recreate a set of CURIEs from a set ID, but the same set of CURIEs given to the same version of Node Normalization will always return the same set ID.",
        "operationId": "get_setid_get",
        "parameters": [
          {
            "name": "curie",
            "in": "query",
            "description": "Set of curies to normalize",
            "required": true,
            "schema": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "example": ["MESH:D014867", "NCIT:C34373", "UNII:63M8RYN44N", "RUBBISH:1234"]
          },
          {
            "name": "conflation",
            "in": "query",
            "description": "Set of conflations to apply; see /get_allowed_conflations",
            "required": false,
            "schema": {
              "type": "array",
              "items": {"type": "string"},
              "default": []
            },
            "example": ["GeneProtein", "DrugChemical"]
          }
        ],
        "responses": {
          "200": {
            "description": "The set ID for the input CURIEs",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SetIDResponse"}
              }
            }
          },
          "400": {
            "description": "No `curie` parameter was supplied"
          }
        }
      },
      "post": {
        "summary": "Normalize and deduplicate several sets of identifiers and return a hash for each set.",
        "tags": ["translator"],
        "description": "Returns one set ID per input set, in the order the sets were given.",
        "operationId": "get_setid_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {"$ref": "#/components/schemas/SetIDQuery"},
                "minItems": 1
              },
              "example": [
                {"curies": ["MESH:D014867", "NCIT:C34373"]},
                {
                  "curies": ["NCIT:C34373", "MESH:D014867", "UNII:63M8RYN44N", "RUBBISH:1234"],
                  "conflations": ["GeneProtein", "DrugChemical"]
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "One set ID per input set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/SetIDResponse"}
                }
              }
            }
          },
          "400": {
            "description": "The body is not a non-empty JSON array"
          }
        }
      }
    },
    "/get_semantic_types": {
      "get": {
        "summary": "Return a list of Biolink semantic types for which normalization has been attempted.",
        "tags": ["metadata"],
        "description": "Returns the distinct Biolink classes found in the index, together with all of their ancestors.",
        "operationId": "get_semantic_types",
        "responses": {
          "200": {
            "description": "The semantic types in this instance",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SemanticTypes"},
                "example": {
                  "semantic_types": {
                    "types": [
                      "biolink:NamedThing",
                      "biolink:ChemicalEntity",
                      "biolink:SmallMolecule",
                      "biolink:Disease",
                      "biolink:Gene",
                      "biolink:Protein"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_allowed_conflations": {
      "get": {
        "summary": "Return a list of named conflations.",
        "tags": ["metadata"],
        "description": "Returns the conflations this instance can apply. Conflation combines cliques on the fly: <ol> <li><code>GeneProtein</code> merges protein-coding genes with the proteins they encode. The gene(s) always appear first in the combined clique. <li><code>DrugChemical</code> merges chemicals based on their active ingredient. The active ingredient appears before any formulations in the combined clique. </ol> You can <a href=\"https://github.com/NCATSTranslator/Babel/blob/main/docs/Conflation.md\">read more about conflation</a> in the Babel documentation.",
        "operationId": "get_allowed_conflations",
        "responses": {
          "200": {
            "description": "The conflations this instance supports",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ConflationList"},
                "example": {"conflations": ["GeneProtein", "DrugChemical"]}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurieList": {
        "title": "CurieList",
        "description": "Curie list input model",
        "type": "object",
        "required": ["curies"],
        "properties": {
          "curies": {
            "title": "List of CURIEs to normalize",
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "conflate": {
            "title": "Whether to apply gene/protein conflation",
            "type": "boolean",
            "default": true
          },
          "drug_chemical_conflate": {
            "title": "Whether to apply drug/chemical conflation",
            "type": "boolean",
            "default": false
          },
          "description": {
            "title": "Whether to return CURIE descriptions when possible",
            "type": "boolean",
            "default": false
          },
          "individual_types": {
            "title": "Whether to return individual types for equivalent identifiers",
            "type": "boolean",
            "default": false
          }
        },
        "example": {
          "curies": ["MESH:D014867", "NCIT:C34373"],
          "conflate": true,
          "drug_chemical_conflate": false,
          "description": false,
          "individual_types": false
        }
      },
      "Identifier": {
        "title": "Identifier",
        "description": "A CURIE with its label, and optionally its description and Biolink type",
        "type": "object",
        "required": ["identifier"],
        "properties": {
          "identifier": {"type": "string"},
          "label": {"type": "string"},
          "description": {"type": "string", "description": "Only when `description` was requested"},
          "type": {"type": "string", "description": "Only when `individual_types` was requested"}
        }
      },
      "NormalizedNode": {
        "title": "NormalizedNode",
        "description": "The clique an input CURIE belongs to",
        "type": "object",
        "required": ["id", "equivalent_identifiers", "type", "taxa"],
        "properties": {
          "id": {
            "description": "The preferred identifier for this clique",
            "$ref": "#/components/schemas/Identifier"
          },
          "equivalent_identifiers": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Identifier"}
          },
          "type": {
            "description": "Biolink classes for this clique, most specific first",
            "type": "array",
            "items": {"type": "string"}
          },
          "information_content": {
            "type": "number",
            "description": "Omitted when Babel has no information content for this clique"
          },
          "descriptions": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Only when `description` was requested"
          },
          "taxa": {
            "type": "array",
            "items": {"type": "string"},
            "description": "NCBITaxon CURIEs this clique is associated with"
          }
        }
      },
      "NormalizedNodes": {
        "title": "NormalizedNodes",
        "description": "One normalized node per input CURIE, keyed by the input CURIE; `null` when the CURIE is unknown",
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {"$ref": "#/components/schemas/NormalizedNode"},
            {"type": "null"}
          ]
        }
      },
      "SetIDQuery": {
        "title": "SetIDQuery",
        "type": "object",
        "required": ["curies"],
        "properties": {
          "curies": {
            "title": "Set of CURIEs",
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "conflations": {
            "title": "Conflations to apply; see /get_allowed_conflations",
            "type": "array",
            "items": {"type": "string"},
            "default": []
          }
        }
      },
      "SetIDResponse": {
        "title": "SetIDResponse",
        "type": "object",
        "required": ["curies", "conflations", "error", "normalized_curies", "normalized_string", "setid"],
        "properties": {
          "curies": {"type": "array", "items": {"type": "string"}},
          "conflations": {"type": "array", "items": {"type": "string"}},
          "error": {"type": ["string", "null"], "description": "Set when the conflations are not all allowed"},
          "normalized_curies": {
            "type": ["array", "null"],
            "items": {"type": "string"},
            "description": "The preferred identifiers, deduplicated and sorted; unknown CURIEs pass through unchanged"
          },
          "normalized_string": {"type": ["string", "null"], "description": "`normalized_curies` joined with `||`"},
          "setid": {"type": ["string", "null"], "description": "UUID v5 of `normalized_string`, prefixed `uuid:`"}
        },
        "example": {
          "curies": ["MESH:D014867", "NCIT:C34373", "UNII:63M8RYN44N", "RUBBISH:1234"],
          "conflations": ["GeneProtein", "DrugChemical"],
          "error": null,
          "normalized_curies": ["CHEBI:15377", "MONDO:0004976", "RUBBISH:1234"],
          "normalized_string": "CHEBI:15377||MONDO:0004976||RUBBISH:1234",
          "setid": "uuid:771d3c09-9a8c-5c46-8b85-97f481a90d40"
        }
      },
      "SemanticTypes": {
        "title": "SemanticTypes",
        "type": "object",
        "required": ["semantic_types"],
        "properties": {
          "semantic_types": {
            "type": "object",
            "required": ["types"],
            "properties": {
              "types": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      },
      "ConflationList": {
        "title": "ConflationList",
        "type": "object",
        "required": ["conflations"],
        "properties": {
          "conflations": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "examples": {
      "NormalizedNodes": {
        "summary": "Water, ALS and an unknown CURIE, with descriptions and individual types requested",
        "value": {
          "MESH:D014867": {
            "id": {
              "identifier": "CHEBI:15377",
              "label": "Water",
              "description": "An oxygen hydride consisting of an oxygen atom that is covalently bonded to two hydrogen atoms"
            },
            "descriptions": [
              "An oxygen hydride consisting of an oxygen atom that is covalently bonded to two hydrogen atoms"
            ],
            "equivalent_identifiers": [
              {
                "identifier": "CHEBI:15377",
                "label": "water",
                "description": "An oxygen hydride consisting of an oxygen atom that is covalently bonded to two hydrogen atoms",
                "type": "biolink:SmallMolecule"
              },
              {
                "identifier": "CHEBI:44701",
                "label": "",
                "type": "biolink:SmallMolecule"
              }
            ],
            "type": [
              "biolink:SmallMolecule",
              "biolink:MolecularEntity",
              "biolink:OntologyClass",
              "biolink:ChemicalEntity",
              "biolink:PhysicalEssence",
              "biolink:ChemicalOrDrugOrTreatment",
              "biolink:ChemicalEntityOrGeneOrGeneProduct",
              "biolink:ChemicalEntityOrProteinOrPolypeptide",
              "biolink:NamedThing",
              "biolink:PhysicalEssenceOrOccurrent"
            ],
            "information_content": 47.5,
            "taxa": []
          },
          "NCIT:C34373": {
            "id": {
              "identifier": "MONDO:0004976",
              "label": "amyotrophic lateral sclerosis",
              "description": "Amyotrophic lateral sclerosis (ALS) is a neurodegenerative disease characterized by progressive muscular paralysis reflecting degeneration of motor neurons in the primary motor cortex, corticospinal tracts, brainstem and spinal cord."
            },
            "descriptions": [
              "Amyotrophic lateral sclerosis (ALS) is a neurodegenerative disease characterized by progressive muscular paralysis reflecting degeneration of motor neurons in the primary motor cortex, corticospinal tracts, brainstem and spinal cord."
            ],
            "equivalent_identifiers": [
              {
                "identifier": "MONDO:0004976",
                "label": "amyotrophic lateral sclerosis",
                "description": "Amyotrophic lateral sclerosis (ALS) is a neurodegenerative disease characterized by progressive muscular paralysis reflecting degeneration of motor neurons in the primary motor cortex, corticospinal tracts, brainstem and spinal cord.",
                "type": "biolink:Disease"
              },
              {
                "identifier": "DOID:332",
                "label": "amyotrophic lateral sclerosis",
                "type": "biolink:Disease"
              }
            ],
            "type": [
              "biolink:Disease",
              "biolink:DiseaseOrPhenotypicFeature",
              "biolink:OntologyClass",
              "biolink:BiologicalEntity",
              "biolink:ThingWithTaxon",
              "biolink:NamedThing"
            ],
            "information_content": 74.9,
            "taxa": []
          },
          "RUBBISH:1234": null
        }
      }
    }
  }
}
